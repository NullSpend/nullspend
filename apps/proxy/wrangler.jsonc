{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nullspend",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-09",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  // proxy.nullspend.dev is the public proxy URL. Configured as a custom
  // domain via the Cloudflare dashboard on 2026-04-08 (task P0-F).
  // Declared here so `pnpm proxy:deploy` manages it via code going forward,
  // instead of drifting from the dashboard-only state.
  "routes": [
    { "pattern": "proxy.nullspend.dev", "custom_domain": true }
  ],
  "vars": {
    // PR-2c: plan-counter enforcement flag.
    // FLIPPED 2026-04-19 in PR-2e Sub-PR 20 — launch gate.
    // Rollback: set back to "false" + pnpm proxy:deploy (guard script wraps).
    "PLAN_COUNTER_ENABLED": "true",
    // NULLSPEND_CLOUD gates the cloud-vs-self-hosted identity branch in
    // api-key-auth.ts::lookupKeyInDb. When NOT set to "true" (case-insensitive),
    // ALL API keys resolve to the self-hosted identity shape with
    // planLimitBlockAt: null — which short-circuits plan-counter enforcement
    // entirely, regardless of PLAN_COUNTER_ENABLED. Missed during the
    // PR-2e Sub-PR 20 pre-flip review because the deploy guard only checks
    // PLAN_COUNTER_ENABLED, not NULLSPEND_CLOUD. Caught 2026-04-20 during
    // live-stack T2 testing when counter didn't advance on proxy/MCP paths.
    "NULLSPEND_CLOUD": "true"
  },
  "ratelimits": [
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "KEY_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ae987aca79704f1fa94bf2c4bb761f14"
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "METRICS", "dataset": "proxy_latency" }
  ],
  "kv_namespaces": [
    { "binding": "CACHE_KV", "id": "a1c41950606849ccbfc4c044d80bbca4" }
  ],
  "r2_buckets": [
    { "binding": "BODY_STORAGE", "bucket_name": "nullspend-request-bodies" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "USER_BUDGET", "class_name": "UserBudgetDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserBudgetDO"] }
  ],
  // PR-2d: plan-counter drift reconciliation. The handler in
  // src/routes/reconcile-plan-counter-cron.ts picks up cost_events tagged
  // `_ns_counter_sync_skipped` (dashboard fail-open path) and replays the
  // DO increment with the event's stored periodStart/End. 15 minutes gives
  // real-time-ish convergence with plenty of CPU-budget headroom per tick.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "queues": {
    "producers": [
      { "binding": "COST_EVENT_QUEUE", "queue": "nullspend-cost-events" },
      { "binding": "WEBHOOK_QUEUE", "queue": "nullspend-webhooks" }
    ],
    "consumers": [
      {
        "queue": "nullspend-cost-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "nullspend-cost-events-dlq",
        "retry_delay": 5
      },
      {
        "queue": "nullspend-cost-events-dlq",
        "max_retries": 0
      },
      {
        "queue": "nullspend-webhooks",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "dead_letter_queue": "nullspend-webhooks-dlq",
        "retry_delay": 10
      },
      {
        "queue": "nullspend-webhooks-dlq",
        "max_retries": 0
      }
    ]
  }
}
