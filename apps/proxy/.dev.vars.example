DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
INTERNAL_SECRET=dev-internal-secret-replace-me
# Dual-secret rotation overlap (PR-2d / Decision #40). Set to current INTERNAL_SECRET
# during rotation so both the old and new secrets are accepted; unset/empty once
# the dashboard's PROXY_INTERNAL_SECRET has been cut over to the new value.
INTERNAL_SECRET_NEXT=
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-analytics-engine-api-token
