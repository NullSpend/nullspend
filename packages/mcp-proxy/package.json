{
  "name": "@nullspend/mcp-proxy",
  "version": "0.1.1",
  "description": "MCP proxy that gates risky tool calls through NullSpend approval before forwarding to an upstream MCP server",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/NullSpend/nullspend",
    "directory": "packages/mcp-proxy"
  },
  "homepage": "https://nullspend.dev",
  "author": "NullSpend <chris@nullspend.dev>",
  "keywords": [
    "nullspend",
    "mcp",
    "proxy",
    "gateway",
    "tool-gating",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nullspend-mcp-proxy": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nullspend/sdk": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
